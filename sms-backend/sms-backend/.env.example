# Copy this file to .env and fill in your real values
# MongoDB Atlas connection string (or local mongodb://localhost:27017/sms)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sms?retryWrites=true&w=majority

# Any long random string — generate with: openssl rand -hex 32
JWT_SECRET=replace_this_with_a_long_random_secret

PORT=5000
